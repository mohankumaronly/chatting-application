	"item": [
		{
			"name": "1. Registration & OTP",
			"item": [
				{
					"name": "1.1 Start Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.registrationId) {",
									"    pm.collectionVariables.set(\"registrationId\", jsonData.registrationId);",
									"}",
									"if (jsonData.challengeToken) {",
									"    pm.collectionVariables.set(\"challengeToken\", jsonData.challengeToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"mohankumar@example.com\",\n  \"dateOfBirth\": \"2000-05-15\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/registrations",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"registrations"
							]
						}
					}
				},
				{
					"name": "1.2 Resend OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Challenge-Token",
								"value": "{{challengeToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/registrations/{{registrationId}}/otp/resend",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"registrations",
								"{{registrationId}}",
								"otp",
								"resend"
							]
						}
					}
				},
				{
					"name": "1.3 Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Challenge-Token",
