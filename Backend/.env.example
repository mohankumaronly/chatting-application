# Application
APP_NAME=chat-backend
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_app
DB_USERNAME=chat_app_user
DB_PASSWORD=replace_with_local_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT_MS=2000

# Access token
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=chat-api
JWT_ACCESS_TOKEN_TTL_SECONDS=600
JWT_SIGNING_KEY_BASE64=replace_with_generated_secret

# Refresh session policy
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_REMEMBER_TTL_SECONDS=2592000

# Browser cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth

# Brevo
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=replace_with_verified_sender
BREVO_SENDER_NAME=Chat App

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_client_id
GOOGLE_CLIENT_SECRET=replace_with_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OTP
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Registration
REGISTRATION_CHALLENGE_TTL_SECONDS=1200

# Password reset
PASSWORD_RESET_TTL_SECONDS=600

# Username policy
USERNAME_CHANGE_COOLDOWN_DAYS=30

# Account deletion
ACCOUNT_DELETION_GRACE_DAYS=20
ACCOUNT_DELETION_BATCH_SIZE=100
ACCOUNT_DELETION_SCHEDULER_CRON=0 0 * * * *

# Blocking
BLOCK_MAX_PER_HOUR=100

# Recovery token
DELETION_RECOVERY_TOKEN_TTL_SECONDS=1728000
DELETION_RECOVERY_HMAC_KEY_BASE64=replace_with_separate_key

# Field encryption / lookup
FIELD_ENCRYPTION_KEY_BASE64=replace_with_separate_key
IDENTIFIER_HMAC_KEY_BASE64=replace_with_separate_key
OTP_HMAC_KEY_BASE64=replace_with_separate_key

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_AVATAR_FOLDER=chat-app/avatars